     "id": "MA-PS-ACCELERATION",
     "reference": "STREAK3_ACCEL: at the close before the trade day at least 3 consecutive higher closes, each return >= the one before, their sum >= 3 x ADR20 and the close above the 10-day MA",
     "alternatives": [
      "STREAK4_ACCEL: at least 4",
      "STREAK3_NO_ACCEL: no acceleration condition"
     ],
     "why": "KK-018 \"several strongly accelerated up days\" has no number; KK-019 sizes are examples only. ADR20 (KK-031) scales \"strongly\" to the stock"
    },
    {
     "id": "MA-PS-HISTORY",
     "reference": "a candidate needs 31 sessions up to the signal close",
     "alternatives": [],
     "why": "ADR20, the 10-day MA and the streak evidence need them; shorter histories are not screened (declared)"
    },
    {
     "id": "MA-PS-IDENTITY",
     "reference": "first IEX print within the first 5 minutes and within 5 % of the raw official open; the whole-day high / low agreement (R9) is evidence only",
     "alternatives": [],
     "why": "ticker reuse; the gate must be known at the decision, never selected by the day's outcome"
    },
    {
     "id": "MA-PS-IEX-PRINTS",
     "reference": "every IEX minute after the fill is taken as printed (no per-minute outlier filter); a single bad print can trigger the stop or a target",
     "alternatives": [],
     "why": "a filter would need the day after the decision; the whole-day agreement is reported per trade (dayRangeAgreement)"
    },
    {
     "id": "MA-PS-ENTRY",
     "reference": "ORL_5: short one raw cent below the 5-minute opening range low (IEX lows and the official open), active from minute 5",
     "alternatives": [
      "FIRST_RED_5MIN: below the low of the first completed red 5-minute candle",
      "FAILED_VWAP_RETEST: after a minute closed below the IEX VWAP, the first minute that trades up to the VWAP and closes below it; short at that close"
     ],
     "why": "KK-020 / KK-021 (OPTIONAL) leave the choice open; \"ORL\" names no length, 5 minutes matches the 5-minute candle of KK-020"
    },
    {
     "id": "MA-PS-FILL",
     "reference": "fill = min(level, open of the first IEX minute whose low reaches the level) (never better than the level)",
     "alternatives": [],
     "why": "IEX prints can jump; a consolidated fill is not known"
    },
    {
     "id": "MA-PS-STOP",
     "reference": "HOD: buy stop one raw cent above the high of day before the fill minute (official open included), stop-market",
     "alternatives": [
      "VWAP_RECLAIM: cover at the close of the first minute after the fill that closes above the IEX VWAP (high-of-day stop kept as the hard stop)"
     ],
     "why": "KK-022 (CONTEXTUAL) names both"
    },
    {
     "id": "MA-PS-TARGET",
     "reference": "MA10: cover the whole position at the 10-day MA of the prior close (limit; an open below it covers at the open)",
     "alternatives": [
      "MA20",
      "HALF_MA10_REST_MA20"
     ],
     "why": "KK-023 (PREFERENCE) \"toward the 10 / 20-day MA, early partials\" gives no split"
    },
    {
     "id": "MA-PS-SAME-MINUTE",
     "reference": "PESSIMISTIC: a minute (or daily bar) that reaches both the stop and the target is a stop",
