   "modelAssumptions": [
    {
     "id": "MA-EP-CATALYST-NOT-VERIFIED",
     "phase": "SETUP_QUALIFICATION",
     "reference": "NOT_VERIFIED: no catalyst filter; no setup is an original EP",
     "alternatives": [],
     "why": "owner decision 2026-10-23: chart-first, no news / catalyst history (KK-SF-EP-CATALYST DATA_BLOCKED)"
    },
    {
     "id": "MA-EP-HISTORY",
     "phase": "SETUP_QUALIFICATION",
     "reference": "a candidate needs 64 prior sessions in the snapshot (63-session range / run evidence + prior close)",
     "alternatives": [],
     "why": "the quiet-phase evidence (KK-035) and its alternative read 63 sessions; a shorter history is not screened (IPO gaps are therefore excluded, declared)"
    },
    {
     "id": "MA-EP-IDENTITY",
     "phase": "ENTRY_ELIGIBILITY",
     "reference": "first IEX print within the first 5 minutes and within 5 % of the raw official open; otherwise not executed. The whole-day IEX high / low agreement (R9, 1 %) is evidence only",
     "alternatives": [],
     "why": "tickers are reused after delistings; the gate must be known at the decision, a whole-day check would select days by their outcome"
    },
    {
     "id": "MA-EP-IEX-PRINTS",
     "phase": "INITIAL_STOP",
     "reference": "every IEX minute after the fill is taken as printed (no per-minute outlier filter); a single bad print can trigger the same-day stop",
     "alternatives": [],
     "why": "a filter would need the day after the decision; the whole-day agreement is reported as evidence (dayRangeAgreement)"
    },
    {
     "id": "MA-EP-GAP-SCREEN",
     "phase": "SETUP_QUALIFICATION",
     "reference": "official open / prior close - 1 >= 10 % (KK-015 printed size as a declared screen convention)",
     "alternatives": [],
     "why": "KK-015 is a STRONG_PREFERENCE description; the printed 10 % is the only number the source gives"
    },
    {
     "id": "MA-EP-QUIET-PHASE",
     "phase": "SETUP_QUALIFICATION",
     "reference": "NONE: the prior range and run are evidence only (KK-SF-EP-SIDEWAYS manual)",
     "alternatives": [
      "PRIOR_RUN_LIMIT_50: prior close at most 50 % above the lowest low of the 63 sessions before the gap (\"without a big prior run\", declared convention)"
     ],
     "why": "KK-035 \"ideally 3-6 months sideways\" gives no measure"
    },
    {
     "id": "MA-EP-VOLUME-PACE",
     "phase": "ENTRY_ELIGIBILITY",
     "reference": "PACE_20: before the entry minute k <= 20 the cumulative IEX volume since the open is at least the mean IEX daily volume of the 20 prior sessions x k / 20; after minute 20 only if the IEX volume of minutes 0-19 reached that average. Baseline: mean over all 20 prior sessions (a session without IEX volume counts 0), only when at least 15 of them have IEX volume, otherwise not executed",
     "alternatives": [
      "NONE: no volume condition (volume reported as evidence)"
     ],
     "why": "KK-037 \"ideally the daily average within 15-20 minutes\" read on the IEX venue only (IEX is 1-5 % of the market; never compared with consolidated volume)"
    },
    {
     "id": "MA-EP-ORH",
     "phase": "ENTRY_EXECUTION",
     "reference": "ORH_1: buy stop one raw cent above the opening range of the first session minute (its IEX high and the official open), active from minute 1",
     "alternatives": [
      "ORH_5: above the 5-minute opening range high, active from minute 5 (KK-033)"
     ],
     "why": "KK-032 \"mostly the first 1-minute opening range high\""
    },
    {
     "id": "MA-EP-FILL",
     "phase": "ENTRY_EXECUTION",
     "reference": "fill = max(level, open of the first IEX minute whose high reaches the level) (IEX prints can jump; never better than the level)",
     "alternatives": [],
     "why": "IEX is one venue; a consolidated fill price is not known"
    },
    {
     "id": "MA-EP-LOD-AT-ENTRY",
     "phase": "INITIAL_STOP",
     "reference": "low of day = min(official open, IEX lows of the minutes BEFORE the fill minute)",
     "alternatives": [],
     "why": "the opening auction is not an IEX print (R9 A4); the fill minute's own low is not known to precede the fill"
    },
    {
     "id": "MA-EP-FILL-MINUTE-STOP",
     "phase": "INITIAL_STOP",
     "reference": "PESSIMISTIC: a fill minute whose low reaches the stop exits at the stop",
     "alternatives": [
      "OPTIMISTIC"
     ],
     "why": "inside one minute the order of the fill and the low is unknown"
    },
    {
     "id": "MA-EP-EXIT",
     "phase": "EXIT_CONDITIONS",
     "reference": "MA20: first daily close below the 20-day MA exits at the next open (plus the low-of-day stop-market)",
     "alternatives": [
      "MA10",
      "MA50"
     ],
     "why": "KK-017 names 20 / 50 and later 10 / 20-day MAs (SOURCE_AMBIGUOUS, KK-C2); 20 is named in both readings"
    },
    {
     "id": "MA-EP-SIZING",
     "phase": "POSITION_SIZING",
     "reference": "RISK 0.005 of equity to the low-of-day stop, KK-001 cap 30 % (platform 25 %)",
     "alternatives": [
      "RISK 0.0025",
      "RISK 0.01"
     ],
     "why": "KK-SF-SIZE is the reviewer's; the printed context ranges KK-003 / KK-025"
    },
    {
     "id": "MA-EP-UNIVERSE",
     "phase": "ENTRY_ELIGIBILITY",
     "reference": "VU_TOURNAMENT_UNIVERSE_705 at the session before the gap day",
     "alternatives": [],
     "why": "measurement convention shared by every method"
    },
    {
     "id": "MA-EP-COSTS",
     "phase": "ENTRY_EXECUTION",
     "reference": "10 bps slippage per side, 1 bp commission (platform policy)",
     "alternatives": [],
     "why": "no costs in the source"
    }
