    "general_redistribution_commercial_license": "UNCERTIFIED_FROM_INSPECTED_OFFICIAL_PAGES",
    "conservative_handling": "Source metadata may be reported here; factor values are omitted. No new paid provider or integration is introduced."
  },
  "source_convention_notes": [
    "CRSP FIZ-to-CIZ transition begins with January2025 releases and changes dividend reinvestment/compounding conventions.",
    "Archive headers document the RF source transition beginning June2024 from Ibbotson to the ICE BofA US 1-Month Treasury Bill Index.",
    "These source-convention differences are documented; no silent splice or factor substitution was performed."
  ],
