# vu-backup – Beispielkonfiguration. KEINE echten Werte in diese Datei.
# Werte stehen im Runner als Secrets (GitHub Environment "backup" bzw. Secret Manager),
# die Vorlage zeigt nur Namen und Form.

# ---- Ziel: restic-Repository in Backblaze B2 (S3-kompatible API, EU Central)
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/<bucket-name>/restic
RESTIC_PASSWORD=<aus dem Passwortmanager, 32+ Zeichen, nie im Repository>
AWS_ACCESS_KEY_ID=<keyID des Schreibschluessels "vu-backup-writer">
AWS_SECRET_ACCESS_KEY=<applicationKey des Schreibschluessels>
# Rechte des Schreibschluessels (vu-key-check.py writer prueft das vor jedem Lauf):
#   listBuckets, listFiles, readFiles, writeFiles – beschraenkt auf <bucket-name>
#   NICHT: deleteFiles, bypassGovernance, writeFileRetentions, writeFileLegalHolds, writeBuckets, *Keys
VU_B2_KEY_CHECK=true

# ---- Quellen (jede einzeln abschaltbar ueber VU_SOURCES)
VU_SOURCES="git github-meta gh-artifacts r2 cf-kv cf-config brevo supabase"

# Git: name=URL, Leerzeichen-getrennt. Oeffentliche Repos brauchen kein Token.
VU_GIT_REPOS="research=https://github.com/<owner>/<repo>.git landing=https://github.com/<owner>/<landing-repo>.git"
VU_GIT_MODE=bundle   # bundle (Standard, wenig Egress) | incremental | fresh
# Fine-grained PAT, nur diese Repos, nur lesend: Contents, Metadata, Issues, Pull requests,
# Actions (Artefakte), optional Secrets/Variables/Administration (nur Namen und Einstellungen).
VU_GITHUB_TOKEN=<fine-grained PAT, Ablauf <= 90 Tage>
VU_GITHUB_REPOS="<owner>/<repo> <owner>/<landing-repo>"
# Actions-Artefakte, die gesichert werden (fnmatch-Muster). Leer = keine.
VU_ARTIFACT_ALLOWLIST="vu-accounts-backup"

# Cloudflare R2 – eigenes Token "Object Read only", nur dieser Bucket
VU_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
VU_R2_BUCKET=<r2-bucket>
VU_R2_ACCESS_KEY_ID=<R2 read-only access key id>
VU_R2_SECRET_ACCESS_KEY=<R2 read-only secret>
# Stufe 1: jeder Lauf. Stufe 2: nur mit --tier2 (neu erzeugbar, gross).
VU_R2_PREFIXES_TIER1="ci-state=<praefix>/ research-snapshots=<praefix>/ social-assets=<praefix>/ backtest-series=<praefix>/"
VU_R2_PREFIXES_TIER2="price-history=<praefix>/ sec=<praefix>/"

# Cloudflare API – Token mit: Workers KV Storage:Read, Workers Scripts:Read, Zone DNS:Read
VU_CF_API_TOKEN=<Cloudflare API token, nur Leserechte>
VU_CF_ACCOUNT_ID=<account id>
VU_CF_KV_NAMESPACES="social=<namespace-id>"
VU_CF_ZONE_IDS="visionuniverse=<zone-id>"

# Brevo – personenbezogen, nur nach Owner-Freigabe einschalten
VU_BREVO_ENABLED=false
VU_BREVO_API_KEY=<eigener Brevo-Schluessel "backup">

# Supabase – eigene Rolle mit Leserecht, Session-Pooler-URI
VU_SUPABASE_PROJECT=<project-ref>
VU_SUPABASE_DB_URL=postgresql://<backup-rolle>.<project-ref>:<passwort>@<pooler-host>:5432/postgres

# ---- Pruefung, Meldungen
VU_CHECK_SUBSET=2%
VU_MAX_DROP_PERCENT=10
VU_STALE_WARN_DAYS=4
VU_STALE_FAIL_DAYS=7
# Totmannschalter (z. B. healthchecks.io, kostenloser Tarif): Periode 3 Tage, Kulanz 1 Tag.
VU_HEALTHCHECK_URL=<ping-url>
