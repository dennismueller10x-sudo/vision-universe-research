<!doctype html>
<html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>$subject</title><style>@media(max-width:620px){.wrap{width:100%!important}.title{font-size:28px!important}}</style></head>
<body style="margin:0;background:#f4f4f4;color:#111;font-family:Inter,Arial,Helvetica,sans-serif">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all">$preheader</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td align="center" style="padding:20px 8px">
<table role="presentation" class="wrap" width="600" cellspacing="0" cellpadding="0" style="max-width:600px;background:#fff">
<tr><td style="padding:32px 24px;border-bottom:1px solid #eee">
<img src="https://raw.githubusercontent.com/dennismueller10x-sudo/vision-universe-research/6f26b4e958a0c96bb3ddbe4aa0c20bfe85799c1c/assets/vision-universe-logo-web.png" alt="Vision Universe" width="190" style="display:block;max-width:100%;height:auto"></td></tr>
<tr><td style="padding:32px 24px 24px"><h1 class="title" style="margin:0 0 20px;font-size:34px;line-height:1.2;letter-spacing:-1px">$subject</h1>
<p style="margin:0;font-size:17px;line-height:1.65">$intro</p></td></tr>
$items_html
<tr><td style="padding:0 24px 36px"><table role="presentation" cellspacing="0" cellpadding="0"><tr><td bgcolor="#111111" style="border-radius:4px">
<a href="$cta_url" style="display:inline-block;padding:15px 24px;color:#fff;text-decoration:none;font-size:16px;font-weight:600">$cta_text</a></td></tr></table></td></tr>
<tr><td style="border-top:1px solid #eee;padding:24px;font-size:12px;line-height:1.7;color:#555">
<p style="margin:0 0 12px">$company_name<br>$company_address</p>
<a href="{{ unsubscribe }}" style="color:#555;text-decoration:underline">Vom Newsletter abmelden</a>
</td></tr></table></td></tr></table></body></html>
