  "high52w": {
    "engineVersion": "high52w-1.0.0",
    "lookbackTradingDays": 252,
    "minBars": 200,
    "priceSeriesType": "SPLIT_ADJUSTED",
    "note": "Das rollierende 52-Wochen-Hoch wird vorberechnet; zur Laufzeit wird nur der aktuelle Kurs dagegen gehalten. Das Hoch des Vergleichsfensters schliesst den aktuellen Tag aus - sonst waere jeder Titel per Definition auf seinem Hoch.",
    "nearHighPct": 0.02,
    "watchPct": 0.05,
    "maxQuoteAgeMs": 900000
  },
  "signals": {
    "new52WeekHigh": {
      "label": "NEW HIGH",
      "rule": "currentPrice >= previous52WeekHigh (Kursreihe SPLIT_ADJUSTED, Vergleichsfenster ohne aktuellen Tag)"
    },
    "nearHigh": {
      "label": "NEAR HIGH",
      "rule": "distanceTo52wHigh >= -high52w.watchPct und kein neues Hoch"
    },
    "marketLeader": {
      "label": "MARKET LEADER",
      "rule": "leadershipPercentile >= 90 innerhalb des Universums"
    },
    "momentumLeader": {
      "label": "MOMENTUM LEADER",
      "rule": "momentumPercentile >= 90 innerhalb des Universums"
    },
    "relativeStrengthLeader": {
      "label": "RS LEADER",
      "rule": "relativeStrengthPercentile >= 90 innerhalb des Universums"
    },
    "breakout": {
      "label": "BREAKOUT",
      "rule": "volumeBreakout (Volumen >= 1.5x 60-Tage-Schnitt) und Kurs ueber SMA20 und SMA50 und distanceTo52wHigh >= -0.10"
    },
    "trendIntact": {
      "label": "TREND",
      "rule": "Kurs ueber SMA20, SMA50, SMA100 und SMA200"
    },
    "sectorLeader": {
      "label": "SECTOR LEADER",
      "rule": "leadershipScore unter den Top 3 des Sektors, Sektor mit sectorStatus=CURATED"
    }
  },
  "rows": [
    {
      "id": "new-52-week-highs",
      "title": "NEW 52-WEEK HIGHS",
      "subtitle": "Titel auf oder nahe ihrem Jahreshoch",
