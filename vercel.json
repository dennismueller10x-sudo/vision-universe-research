{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/preview/build-preview-dataset.mjs && node scripts/proof/build-product-proof.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "github": { "silent": true },
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "{quant/config/**,quant/data/proof/product-tickers.json,quant/engines/history-store.js,quant/engines/bar-codec.js,quant/engines/zero-cost-guard.js,scripts/market/storage/s3-driver.mjs}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/quant/data/proof/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "X-Vision-Universe-Dataset", "value": "DERIVED_UNIVERSE; ohlcv-store=NOT_DEPLOYED" }
      ]
    },
    {
      "source": "/api/history",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "X-Vision-Universe-Dataset", "value": "DAILY_OHLCV_FROM_DURABLE_STORE; provider-requests=0" }
      ]
    },
    {
      "source": "/quant/data/preview/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "X-Vision-Universe-Dataset", "value": "DERIVED_UNIVERSE; ohlcv-store=NOT_DEPLOYED" }
      ]
    }
  ]
}
