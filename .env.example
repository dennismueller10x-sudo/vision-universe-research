# =========================================================================
# VISION UNIVERSE — Beispielkonfiguration fuer Marktdatenanbieter
#
# Diese Datei ist eine VORLAGE. Sie enthaelt keine echten Werte und wird
# bewusst committet. Die echte Datei heisst `.env`, steht in .gitignore und
# darf das Repository niemals erreichen.
#
# In der Produktion kommen diese Werte NICHT aus einer Datei, sondern aus
# GitHub-Secrets (Settings -> Secrets and variables -> Actions). Der
# Schluessel existiert dann nur im Speicher des Runners.
#
# Es gibt keinen Weg, einen dieser Werte sicher an den Browser zu geben.
# Vision Universe wird statisch ausgeliefert; alles im Browser ist
# oeffentlich. Deshalb laufen alle Abrufe serverseitig.
# =========================================================================

# --- Marktdaten (Phase 2 aktiv genutzt) ---------------------------------
# Twelve Data, kostenloser Zugang: 8 Anfragen/Minute, 800/Tag.
# Registrierung: https://twelvedata.com/pricing  (Free-Plan)
TWELVE_DATA_API_KEY=

# --- Betriebsmodus ------------------------------------------------------
# mock   = ausschliesslich synthetische Daten (Standard, immer lauffaehig)
# hybrid = echte Kurse fuer das Referenzuniversum, alles andere synthetisch
# live   = nur echte Daten; scheitert bewusst, wenn etwas fehlt
VU_DATA_MODE=mock

# --- Spaetere Kandidaten (Phase 2 nur dokumentiert, nicht angebunden) ----
# Vor der Nutzung: docs/VU_PROVIDER_LICENSE_CHECKLIST.md durcharbeiten.
EODHD_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
TIINGO_API_KEY=
POLYGON_API_KEY=

# Gemeinsame clientseitige Development-/Marketing-Schranke, nur beim Pages-Build.
# GitHub -> Repository -> Settings -> Secrets and variables -> Actions
# RESEARCH_ACCESS_PASSWORD=<secret>
# Nur ein PBKDF2-Pruefwert wird ausgeliefert; niemals Klartext committen/loggen.
RESEARCH_ACCESS_PASSWORD=

# --- Konten und Abo (docs/VU_ACCOUNTS_SUBSCRIPTIONS.md) ------------------
# Ohne VU_ACCOUNTS_ENABLED=true antworten /api/me, /api/premium und
# /api/revenuecat-webhook nur NOT_CONFIGURED. Produktion: Vercel-Umgebung.
VU_ACCOUNTS_ENABLED=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Umgeht Row-Level-Security. Nur Server/Actions, niemals in den Browser.
SUPABASE_SERVICE_ROLE_KEY=
# Exakt der Authorization-Header, den RevenueCat beim Webhook sendet ("Bearer ...").
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
VU_ACCOUNTS_ACCEPT_SANDBOX=
# Privater Bucket fuer Premium-Daten (getrennt vom History-Speicher).
VU_PREMIUM_S3_ENDPOINT=
VU_PREMIUM_S3_BUCKET=
VU_PREMIUM_S3_ACCESS_KEY_ID=
VU_PREMIUM_S3_SECRET_ACCESS_KEY=
VU_PREMIUM_S3_PREFIX=premium/
# Watchlist-Berichte per E-Mail
RESEND_API_KEY=
VU_REPORT_EMAIL_FROM=
