# VORLAGE, NICHT AKTIV (siehe docs/mobile/TESTFLIGHT_STEP_BY_STEP.md). Laeuft nur auf einem macOS-Runner (fastlane ist dort vorinstalliert).
# Manuelle Signierung mit Distribution-Zertifikat (.p12) und App-Store-Profil: kein Mac des Owners und kein Cloud-Signing-Recht noetig.
# Alle Werte kommen aus der Umgebung (GitHub-Umgebung "app-testflight"); nichts davon gehoert ins Repository.
default_platform(:ios)

platform :ios do
  desc "Archiv bauen und intern zu TestFlight hochladen (ohne Warten auf die Verarbeitung)"
  lane :beta do
    bundle_id = "de.visionuniverse.app"
    profile   = ENV.fetch("IOS_PROFILE_NAME")        # Name des App-Store-Profils im Developer-Portal
    team      = ENV.fetch("APPLE_TEAM_ID")
    project   = File.expand_path("../../ios/App/App.xcodeproj", __dir__)
    workspace = File.expand_path("../../ios/App/App.xcworkspace", __dir__)

    setup_ci                                          # temporaerer Schluesselbund nur fuer diesen Lauf

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_content: ENV.fetch("ASC_KEY_P8"), is_key_content_base64: false
    )

    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_P12_PATH"), certificate_password: ENV.fetch("IOS_DIST_P12_PASSWORD"),
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain", keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )
    install_provisioning_profile(path: ENV.fetch("IOS_PROFILE_PATH"))

    # Das Zertifikat wird ueber seine eindeutige Kennung (SHA-1) gewaehlt, nicht ueber einen Namen: Xcode 26 sucht sonst unter
    # "iOS Distribution" und findet das Apple-Distribution-Zertifikat nicht (Lauf 42369793289). Es werden nur Kennung und Name ausgegeben.
    identities = sh("security find-identity -v -p codesigning", log: false)
    puts identities.lines.select { |l| l =~ /Distribution/ }.map { |l| l.sub(/\([A-Z0-9]{10}\)/, "(<TEAM>)") }.join
    identity = identities[/\b([0-9A-F]{40})\b\s+"(?:Apple|iPhone|iOS) Distribution:/, 1]
    UI.user_error!("Kein Distribution-Zertifikat mit privatem Schluessel im Schluesselbund (siehe Liste oben)") if identity.nil?

    # Diagnose (keine Werte): was das Profil erlaubt
    profile_plist = File.join(ENV.fetch("RUNNER_TEMP"), "profile.plist")
    sh("security cms -D -i '#{ENV.fetch("IOS_PROFILE_PATH")}' > '#{profile_plist}'", log: false)
    puts "Profil-Berechtigungen (Schluessel):"
    puts sh("/usr/bin/plutil -extract Entitlements xml1 -o - '#{profile_plist}' | grep '<key>' | sed 's/^[[:space:]]*//'", log: false)

    # Push (TestFlight): Entitlement "production" statt "development" (Distributionsprofil). Fehlt Push im Profil, entfaellt es,
    # sonst scheitert die Signierung; der Build laeuft dann ohne Push. Nur auf dem Runner, die Datei im Repo bleibt unveraendert.
    entitlements = File.expand_path("../../ios/App/App/App.entitlements", __dir__)
    if system("/usr/libexec/PlistBuddy -c 'Print :Entitlements:aps-environment' '#{profile_plist}' >/dev/null 2>&1")
      sh("/usr/libexec/PlistBuddy -c 'Set :aps-environment production' '#{entitlements}'", log: false)
    else
      UI.important("Profil ohne aps-environment: Push-Entitlement entfaellt, Build ohne Push")
      system("/usr/libexec/PlistBuddy -c 'Delete :aps-environment' '#{entitlements}' >/dev/null 2>&1")
    end

    # GoogleService-Info.plist (vom Workflow aus FIREBASE_IOS_PLIST geschrieben) als Bundle-Ressource einbinden; ohne Datei bleibt das Projekt unveraendert.
    firebase_plist = File.expand_path("../../ios/App/App/GoogleService-Info.plist", __dir__)
    if File.exist?(firebase_plist)
      require "xcodeproj"
      proj = Xcodeproj::Project.open(project)
      group = proj.main_group.find_subpath("App", false)
      ref = group.files.find { |f| f.path == "GoogleService-Info.plist" } || group.new_file("GoogleService-Info.plist")
      proj.targets.find { |t| t.name == "App" }.resources_build_phase.add_file_reference(ref, true)
      proj.save
      puts "GoogleService-Info.plist als Ressource eingebunden"
    end

    update_code_signing_settings(
      use_automatic_signing: false, path: project, team_id: team, targets: ["App"], profile_name: profile,
      code_sign_identity: identity, bundle_identifier: bundle_id
    )
    increment_build_number(build_number: ENV.fetch("GITHUB_RUN_NUMBER"), xcodeproj: project)
    increment_version_number(version_number: ENV.fetch("MARKETING_VERSION"), xcodeproj: project)

    build_app(
      workspace: workspace, scheme: "App", configuration: "Release", export_method: "app-store",
      export_options: {signingStyle: "manual", provisioningProfiles: {bundle_id => profile}, teamID: team},
      output_directory: File.expand_path("../../build", __dir__), clean: true
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true, skip_submission: true)
  end
end
