# VORLAGE, NICHT AKTIV. Liegt absichtlich ausserhalb von .github/workflows. Zum Aktivieren in einem eigenen PR dorthin kopieren
# (Owner-Freigabe: Geheimnisse und Umgebung). Zweck: privater interner TestFlight-Upload von Hand, siehe docs/mobile/TESTFLIGHT_PLAN.md.
# Regeln aus CLAUDE.md / ADR-005: kein Commit-Push, Eingaben nur ueber env:, permissions contents: read, Concurrency mit Ref-Name.
name: App - iOS TestFlight (intern, von Hand)

on:
  workflow_dispatch:
    inputs:
      marketing_version:
        description: "Versionsnummer, z. B. 0.1.0"
        required: true
        default: "0.1.0"

permissions:
  contents: read

concurrency:
  group: app-ios-testflight-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  testflight:
    runs-on: macos-15            # Image und Xcode-Version vor Aktivierung pruefen (Apple-Vorgabe fuer das SDK)
    timeout-minutes: 40
    # Umgebung mit erforderlichen Pruefern (Owner), enthaelt die Geheimnisse unten. Nur von main.
    environment: app-testflight
    if: github.ref == 'refs/heads/main'
    env:
      MARKETING_VERSION: ${{ inputs.marketing_version }}
      ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
      ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
      ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
      APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
      VU_SUPABASE_URL: ${{ vars.VU_SUPABASE_URL }}                       # oeffentlich
      VU_SUPABASE_PUBLISHABLE_KEY: ${{ vars.VU_SUPABASE_PUBLISHABLE_KEY }} # oeffentlich
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.ref }}
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - name: Pruefen und Web-Teil bauen
        working-directory: app
        run: |
          set -euo pipefail
          [[ "$MARKETING_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Version ungueltig"; exit 1; }
          npm ci --no-audit --no-fund
          npm test
          npm run build:www
          npx cap sync ios
      - name: API-Schluessel ablegen (nur fuer diesen Lauf)
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/asc"
          printf '%s' "$ASC_KEY_P8" > "$RUNNER_TEMP/asc/AuthKey_${ASC_KEY_ID}.p8"
          chmod 600 "$RUNNER_TEMP/asc/AuthKey_${ASC_KEY_ID}.p8"
      - name: Archiv mit Cloud-Signierung
        working-directory: app/ios/App
        run: |
          set -euo pipefail
          xcodebuild -workspace App.xcworkspace -scheme App -configuration Release \
            -destination 'generic/platform=iOS' -archivePath "$RUNNER_TEMP/App.xcarchive" \
            MARKETING_VERSION="$MARKETING_VERSION" CURRENT_PROJECT_VERSION="$GITHUB_RUN_NUMBER" DEVELOPMENT_TEAM="$APPLE_TEAM_ID" \
            -allowProvisioningUpdates -authenticationKeyPath "$RUNNER_TEMP/asc/AuthKey_${ASC_KEY_ID}.p8" \
            -authenticationKeyID "$ASC_KEY_ID" -authenticationKeyIssuerID "$ASC_ISSUER_ID" archive
      - name: Export und Upload zu TestFlight
        working-directory: app/ios/App
        run: |
          set -euo pipefail
          cat > "$RUNNER_TEMP/ExportOptions.plist" <<PLIST
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0"><dict>
            <key>method</key><string>app-store-connect</string>
            <key>destination</key><string>upload</string>
            <key>teamID</key><string>${APPLE_TEAM_ID}</string>
            <key>signingStyle</key><string>automatic</string>
          </dict></plist>
          PLIST
          xcodebuild -exportArchive -archivePath "$RUNNER_TEMP/App.xcarchive" -exportOptionsPlist "$RUNNER_TEMP/ExportOptions.plist" \
            -allowProvisioningUpdates -authenticationKeyPath "$RUNNER_TEMP/asc/AuthKey_${ASC_KEY_ID}.p8" \
            -authenticationKeyID "$ASC_KEY_ID" -authenticationKeyIssuerID "$ASC_ISSUER_ID"
      - name: Schluessel entfernen
        if: always()
        run: rm -rf "$RUNNER_TEMP/asc"
