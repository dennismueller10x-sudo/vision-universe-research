# VORLAGE, NICHT AKTIV. Liegt absichtlich ausserhalb von .github/workflows. Zum Aktivieren in einem eigenen, kleinen PR dorthin kopieren,
# NACHDEM der Owner die Umgebung "app-testflight" mit erforderlichen Pruefern angelegt und die Geheimnisse gesetzt hat
# (ein Verweis auf eine fehlende Umgebung wuerde sie ungeschuetzt anlegen, vgl. docs/accounts/FREIGABEN.md).
# Zweck: privater interner TestFlight-Upload von Hand, ohne eigenen Mac. Anleitung: docs/mobile/TESTFLIGHT_STEP_BY_STEP.md
# Regeln aus CLAUDE.md / ADR-005: kein Commit-Push, Eingaben nur ueber env:, permissions contents: read, Concurrency mit Ref-Name.
name: App - iOS TestFlight (intern, von Hand)

on:
  workflow_dispatch:
    inputs:
      marketing_version:
        description: "Versionsnummer, z. B. 0.1.0"
        required: true
        default: "0.1.0"

permissions:
  contents: read

concurrency:
  group: app-ios-testflight-${{ github.ref_name }}
  cancel-in-progress: false

jobs:
  testflight:
    runs-on: macos-26            # Xcode 26.x vorinstalliert (Apple verlangt seit 28.04.2026 Xcode 26 fuer Uploads); Image vor Aktivierung pruefen
    timeout-minutes: 45
    environment: app-testflight  # erforderliche Pruefer = Owner; enthaelt die Geheimnisse unten
    if: github.ref == 'refs/heads/main'
    env:
      MARKETING_VERSION: ${{ inputs.marketing_version }}
      APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
      ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
      ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
      ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
      IOS_DIST_P12_BASE64: ${{ secrets.IOS_DIST_P12_BASE64 }}
      IOS_DIST_P12_PASSWORD: ${{ secrets.IOS_DIST_P12_PASSWORD }}
      IOS_PROFILE_BASE64: ${{ secrets.IOS_PROFILE_BASE64 }}
      IOS_PROFILE_NAME: ${{ vars.IOS_PROFILE_NAME }}
      VU_SUPABASE_URL: ${{ vars.VU_SUPABASE_URL }}                       # oeffentlich
      VU_SUPABASE_PUBLISHABLE_KEY: ${{ vars.VU_SUPABASE_PUBLISHABLE_KEY }} # oeffentlich
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.ref }}
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - name: Pruefen und Web-Teil bauen
        working-directory: app
        run: |
          set -euo pipefail
          [[ "$MARKETING_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Version ungueltig"; exit 1; }
          npm ci --no-audit --no-fund
          npm test
          npm run build:www
          npx cap sync ios
      - name: Zertifikat und Profil fuer diesen Lauf ablegen
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/sign"
          printf '%s' "$IOS_DIST_P12_BASE64" | base64 --decode > "$RUNNER_TEMP/sign/dist.p12"
          printf '%s' "$IOS_PROFILE_BASE64" | base64 --decode > "$RUNNER_TEMP/sign/app.mobileprovision"
          chmod 600 "$RUNNER_TEMP"/sign/*
          echo "IOS_DIST_P12_PATH=$RUNNER_TEMP/sign/dist.p12" >> "$GITHUB_ENV"
          echo "IOS_PROFILE_PATH=$RUNNER_TEMP/sign/app.mobileprovision" >> "$GITHUB_ENV"
      - name: Archiv, Signierung und Upload zu TestFlight (fastlane, vorinstalliert)
        working-directory: app/ci
        run: fastlane ios beta
      - name: Geheimnisse entfernen
        if: always()
        run: rm -rf "$RUNNER_TEMP/sign"
