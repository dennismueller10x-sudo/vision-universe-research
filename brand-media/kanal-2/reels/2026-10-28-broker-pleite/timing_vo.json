}, {"w": "was", "s": 54.895, "e": 54.979, "line": 9, "who": "baer"}, {"w": "mit", "s": 55.063, "e": 55.146, "line": 9, "who": "baer"}, {"w": "dem", "s": 55.188, "e": 55.272, "line": 9, "who": "baer"}, {"w": "Broker", "s": 55.314, "e": 55.523, "line": 9, "who": "baer"}, {"w": "passiert.", "s": 55.565, "e": 55.957, "line": 9, "who": "baer"}, {"w": "Merk", "s": 56.637, "e": 56.846, "line": 10, "who": "baer"}, {"w": "dir", "s": 56.888, "e": 56.971, "line": 10, "who": "baer"}, {"w": "also:", "s": 57.013, "e": 57.41, "line": 10, "who": "baer"}, {"w": "Aktien", "s": 57.724, "e": 58.309, "line": 10, "who": "baer"}, {"w": "und", "s": 58.352, "e": 58.477, "line": 10, "who": "baer"}, {"w": "ETFs", "s": 58.519, "e": 58.979, "line": 10, "who": "baer"}, {"w": "sind", "s": 59.147, "e": 59.313, "line": 10, "who": "baer"}, {"w": "Sondervermögen.", "s": 59.398, "e": 60.402, "line": 10, "who": "baer"}, {"w": "Cash", "s": 60.653, "e": 60.861, "line": 10, "who": "baer"}, {"w": "ist", "s": 61.07, "e": 61.363, "line": 10, "who": "baer"}, {"w": "bis", "s": 61.447, "e": 61.572, "line": 10, "who": "baer"}, {"w": "hunderttausend", "s": 61.614, "e": 62.325, "line": 10, "who": "baer"}, {"w": "Euro", "s": 62.367, "e": 62.576, "line": 10, "who": "baer"}, {"w": "geschützt.", "s": 62.702, "e": 63.178, "line": 10, "who": "baer"}, {"w": "Dann", "s": 63.978, "e": 64.181, "line": 11, "who": "bulle"}, {"w": "kann", "s": 64.303, "e": 64.465, "line": 11, "who": "bulle"}, {"w": "ich", "s": 64.506, "e": 64.587, "line": 11, "who": "bulle"}, {"w": "ja", "s": 64.668, "e": 64.75, "line": 11, "who": "bulle"}, {"w": "beruhigt", "s": 64.79, "e": 65.278, "line": 11, "who": "bulle"}, {"w": "weiterschlafen!", "s": 65.4, "e": 66.373, "line": 11, "who": "bulle"}], "segments": [{"who": "bulle", "scene": "duo", "face": "schock", "text": "Hilfe! Was, wenn mein Broker pleitegeht? Ist dann mein ganzes Geld weg?!", "line": 0, "s": 0.0, "e": 4.439}, {"who": "baer", "scene": "duo", "face": "ueber-brille", "text": "Ruhig. Deine Aktien und ETFs gehören gar nicht dem Broker.", "line": 1, "s": 4.799, "e": 9.173}, {"who": "baer", "scene": "dia", "step": 1, "text": "Sie liegen in deinem Depot als Sondervermögen. Geht der Broker pleite, gehören sie nicht zur Insolvenzmasse. Du bekommst sie zurück oder überträgst sie zu einem anderen Depot.", "line": 2, "s": 9.493, "e": 19.19}, {"who": "bulle", "scene": "duo", "face": "verwirrt", "text": "Und mein Geld auf dem Verrechnungskonto?", "line": 3, "s": 19.63, "e": 22.307}, {"who": "baer", "scene": "dia", "step": 2, "text": "Das ist eine normale Einlage. Dafür gilt die gesetzliche Einlagensicherung: bis hunderttausend Euro pro Person und Bank.", "line": 4, "s": 22.747, "e": 30.542}, {"who": "bulle", "scene": "duo", "face": "lacht", "text": "Puh! Also ist alles sicher?", "line": 5, "s": 30.982, "e": 33.11}, {"who": "baer", "scene": "duo", "face": "", "text": "Fast. Ein Restrisiko bleibt: wenn der Broker Fehler macht und Wertpapiere fehlen.", "line": 6, "s": 33.47, "e": 39.628}, {"who": "baer", "scene": "dia", "step": 3, "text": "Dafür gibt es die gesetzliche Anlegerentschädigung. Sie zahlt neunzig Prozent, höchstens zwanzigtausend Euro.", "line": 7, "s": 39.948, "e": 46.766}, {"who": "bulle", "scene": "duo", "face": "schock", "text": "Nur zwanzigtausend?!", "line": 8, "s": 47.206, "e": 48.916}, {"who": "baer", "scene": "duo", "face": "laecheln", "text": "Das ist der seltene Ausnahmefall. Im Normalfall gilt: Deine Aktien gehören dir, egal was mit dem Broker passiert.", "line": 9, "s": 49.276, "e": 56.177}, {"who": "baer", "scene": "dia", "step": 4, "text": "Merk dir also: Aktien und ETFs sind Sondervermögen. Cash ist bis hunderttausend Euro geschützt.", "line": 10, "s": 56.497, "e": 63.398}, {"who": "bulle", "scene": "duo", "face": "lacht", "text": "Dann kann ich ja beruhigt weiterschlafen!", "line": 11, "s": 63.838, "e": 66.593}], "duration": 66.593, "amp": [0.003, 0.004, 0.004, 0.004, 0.002, 0.005, 0.326, 1, 1, 1, 0.161, 0.059, 0.199, 0.844, 0.246, 0.0