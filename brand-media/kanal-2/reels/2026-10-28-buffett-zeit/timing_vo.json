e": 37.075}, {"who": "baer", "scene": "dia", "step": 3, "text": "Und je länger der Schneeball rollt, desto schneller wächst er. Die größten Sprünge kommen ganz am Ende.", "line": 7, "s": 37.395, "e": 43.791}, {"who": "bulle", "scene": "duo", "face": "", "text": "Und wenn er später angefangen hätte?", "line": 8, "s": 44.231, "e": 46.725}, {"who": "baer", "scene": "dia", "step": 4, "text": "Housel rechnet es vor: mit dreißig anfangen, mit sechzig aufhören, gleiche Rendite. Dann hätte Buffett nur rund zwölf Millionen Dollar.", "line": 9, "s": 47.165, "e": 55.599}, {"who": "baer", "scene": "dia", "step": 5, "text": "Nicht vierundachtzig Milliarden. Neunundneunzig Komma neun Prozent weniger.", "line": 10, "s": 55.839, "e": 60.948}, {"who": "bulle", "scene": "duo", "face": "schock", "text": "Gleicher Investor, nur weniger Zeit?!", "line": 11, "s": 61.388, "e": 63.829}, {"who": "baer", "scene": "duo", "face": "laecheln", "text": "Genau. Sein Können ist das Investieren. Sein Geheimnis ist die Zeit.", "line": 12, "s": 64.189, "e": 69.177}, {"who": "bulle", "scene": "duo", "face": "lacht", "text": "Dann fange ich heute an!", "line": 13, "s": 69.537, "e": 71.262}], "duration": 71.262, "amp": [0.004, 0.013, 0.019, 0.023, 0.025, 0.012, 0.022, 0.397, 1, 1, 0.92, 0.842, 1, 1, 0.729, 0.061, 0.655, 0.683, 0.428, 0.108, 0.051, 0.518, 0.688, 0.041, 0.061, 0.173, 0.27, 0.173, 0.091, 0.029, 0.01, 0.118, 0.289, 0.299, 0.289, 0.991, 1, 1, 0.894, 0.366, 0.188, 0.558, 0.607, 0.411, 0.367, 0.421, 0.203, 0.058, 0.078, 0.012, 0.047, 0.063, 0.053, 0.049, 0.039, 0.017, 0.006, 0.469, 0.639, 0.475, 0.534, 0.473, 0.175, 0.462, 0.526, 0.36, 0.058, 0.007, 0.005, 0.312, 0.634, 0.462, 0.433, 0.108, 0.204, 0.141, 0.018, 0.189, 0.573, 0.292, 0.24, 0.608, 0.523, 0.205, 0.437, 0.431, 0.257, 0.169, 0.211, 0.06, 0.099, 0.511, 0.512, 0.345, 0.577, 0.594, 0.261, 0.377, 0.421, 0.248, 0.098, 0.038, 0.067, 0.024, 0.056, 0.149, 0.148, 0.045, 0.065, 0.026, 0.005, 0.004, 0.005, 0.009, 0.009, 0.005, 0.001, 0.0, 0.0, 