277, "line": 12, "who": "bulle"}, {"w": "Amazon?", "s": 71.315, "e": 71.867, "line": 12, "who": "bulle"}, {"w": "Schreib's", "s": 72.077, "e": 72.382, "line": 12, "who": "bulle"}, {"w": "in", "s": 72.42, "e": 72.458, "line": 12, "who": "bulle"}, {"w": "die", "s": 72.496, "e": 72.534, "line": 12, "who": "bulle"}, {"w": "Kommentare!", "s": 72.572, "e": 73.002, "line": 12, "who": "bulle"}, {"w": "Morgen", "s": 73.622, "e": 74.01, "line": 13, "who": "baer"}, {"w": "kommt", "s": 74.281, "e": 74.514, "line": 13, "who": "baer"}, {"w": "der", "s": 74.553, "e": 74.592, "line": 13, "who": "baer"}, {"w": "nächste", "s": 74.63, "e": 74.863, "line": 13, "who": "baer"}, {"w": "Zoo-Ticker.", "s": 75.058, "e": 75.782, "line": 13, "who": "baer"}], "segments": [{"who": "bulle", "scene": "duo", "face": "schock", "text": "Zweihundertzwanzig Milliarden Dollar. In einem Jahr!", "line": 0, "s": 0.0, "e": 2.979}, {"who": "baer", "scene": "duo", "face": "ueber-brille", "text": "So viel steckt Amazon dieses Jahr vor allem in Rechenzentren. Und nächstes Jahr deutlich mehr. Bulle gegen Bär: Lohnt sich das?", "line": 1, "s": 3.239, "e": 10.677}, {"who": "bulle", "scene": "dia", "step": 1, "text": "Meine These: Ja! Die Cloud AWS wächst um neununddreißig Prozent. So schnell wie seit fast fünf Jahren nicht.", "line": 2, "s": 10.997, "e": 17.195}, {"who": "bulle", "scene": "dia", "step": 2, "text": "Kunden haben schon Aufträge über fünfhundertachtundsiebzig Milliarden Dollar unterschrieben. Und Chef Andy Jassy erwartet für die nächsten zwei Jahre jeweils über vierzig Prozent Wachstum.", "line": 3, "s": 17.375, "e": 27.079}, {"who": "baer", "scene": "duo", "face": "ueber-brille", "text": "Schöne Zahlen. Jetzt meine These.", "line": 4, "s": 27.399, "e": 30.305}, {"who": "baer", "scene": "dia", "step": 3, "text": "Das wird teuer. In zwölf Monaten floss nach allen Investitionen mehr Geld raus als rein: minus zweiundvierzig Milliarden Dollar. Dasselbe Problem wie gestern bei Google.", "line": 5, "s": 30.545, "e": 40.496}, {"who": "baer", "scene": "dia", "step": 4, "text": "Dazu ein Ausblick, der vielen Anlegern zu schwach war. Die Aktie: nachbörslich über fünf Prozent im Minus.", "line": 6, "s": 40.676, "e": 47.415}, {"who": "bulle", "scene": "duo", "face": "schock", "text": "Im Minus?! Bei diesen Zahlen?", "line": 7, "s": 47.735, "e": 49.802}, {"who": "bulle", "scene": "dia", "step": 5, "text": "Amazon verdient doch so viel wie nie! Dreizehn Komma neun Prozent operative Marge. Rekord!", "line": 8, "s": 50.042, "e": 55.639}, {"who": "baer", "scene": "duo", "face": "laecheln", "text": "Bestreitet keiner. Die Frage ist nur: Wann kommt das Geld für die Rechenzentren zurück?", "line": 9, "s": 55.959, "e": 61.034}, {"who": "bulle", "scene": "duo", "face": "lacht", "text": "Jassy sagt: Die Kunden reißen ihm die Kapazität aus den Händen!", "line": 10, "s": 61.294, "e": 65.041}, {"who": "baer", "scene": "duo", "face": "ueber-brille", "text": "Und die Anleger sagen: Erst zeigen, dann feiern.", "line": 11, "s": 65.301, "e": 69.163}, {"who": "bulle", "scene": "duo", "face": "lacht", "text": "Und jetzt du: Bulle oder Bär bei Amazon? Schreib's in die Kommentare!", "line": 12, "s": 69.423, "e": 73.222}, {"who": "baer", "scene": "duo", "face": "laecheln", "text": "Morgen kommt der nächste Zoo-Ticker.", "line": 13, "s": 73.482, "e": 76.002}], "duration": 76.002, "amp": [0.004, 0.007, 0.005, 0.004, 0.081, 0.205, 0.341, 0.252, 0.566, 0.97, 0.588, 0.552, 0.712, 0.523, 0.611, 0.973, 0.905, 0.507, 0.596, 0.417, 0.02, 0.061, 0.21, 0.056, 0.586, 0.695, 0.544, 0.559, 0.131, 0.222, 0.245, 0.484, 0.114, 0.109, 0.103, 0.529, 0.527, 0.453, 0.287, 0.393, 0.517, 0.443, 0.351, 0.388, 0.107, 0.477, 0.741, 0.427, 0.195, 0.638, 0.243, 0.113, 0.095, 0.089, 0.141, 0.087, 0.003, 0.003, 0.004, 0.005, 0.011, 0.015, 0.008, 0.006, 0.062, 0.913, 0.934, 0.147, 0.007, 0.335, 0.619, 0.777, 0.894, 1, 0.974, 0.953, 0.733, 0.668, 0.9, 0.678, 0.717, 0.664, 0.242, 0.097, 0.017, 0.003, 0.003, 0.003, 0.002, 0.0, 0.