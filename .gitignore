scripts/hedgefonds/__pycache__/
scripts/dashboard/__pycache__/

# Phase 2 — Zugangsdaten fuer Marktdatenanbieter.
# Der Schluessel gehoert in die Umgebung oder in ein GitHub-Secret,
# niemals in das Repository. Siehe docs/VU_MARKET_DATA_ARCHITECTURE.md.
.env
.env.*
!.env.example
*.key
secrets.json
providers/**/credentials.json

# Phase 4 — SEC Financial Data Core.
# SEC-Rohdaten und der Abruf-Cache sind gross und jederzeit reproduzierbar; sie
# duerfen das oeffentliche Repository nie erreichen. Die normalisierten
# Factbooks sind ebenfalls reproduzierbar und bleiben lokal. Committet werden
# nur die kompakten, pruefbaren Artefakte unter quant/data/sec/.
.sec-cache/
.quant-state/
quant/data/sec/raw/
quant/data/sec/facts/
scripts/quant/**/__pycache__/

# Phase 4A — Arbeitsablage fuer Kursdaten.
# Provider-Historien gehoeren nicht in ein oeffentliches Repository:
# zu gross, und Rohdaten-, Display- sowie Derived-Data-Rechte sind
# ungeklärt. Auch Ausschnitte bleiben bis zur Lizenzfreigabe intern.
.market-cache/

# Der Vorschaudatensatz und seine Ansicht entstehen zur BAUZEIT (Vercel)
# und werden nie committet. Genau das haelt GitHub Pages unveraendert:
# dort gibt es diese Dateien nicht.
quant/data/preview/
preview-universe/

# Der Produktnachweis auf dem vollen Universum entsteht ebenfalls zur
# BAUZEIT: scripts/proof/build-product-proof.mjs baut den Datensatz und
# kopiert die Oberflaeche aus _proof-src/ nach /universe/. Beides wird nie
# committet — die Quelle der Oberflaeche liegt unter _proof-src/ und ist
# als Code lesbar; die Auslieferung existiert nur in der geschuetzten
# Vorschau.
quant/data/proof/
/universe/

# Phase "US Security Master" — Laufzustand der Nullkostenschranke.
# preflight.json ist eine FREIGABE fuer genau einen Lauf: sie stuetzt
# sich auf den Nutzungsstand und den belegten Speicher im Moment der
# Rechnung. Committet waere sie eine Freigabe auf Vorrat - genau das,
# was die Schranke verhindern soll. sync.json ist der Bericht eines
# einzelnen Laufs und gehoert zu ihm, nicht ins Repository.
# Die Pflichtrechnung preflight-backfill-7800.json bleibt committet:
# sie ist eine Planungsgrundlage und keine Freigabe.
quant/data/market/history/preflight.json
quant/data/market/history/sync.json
# Der Befund der Historienfunktion gehoert zu EINEM Lauf und seiner
# Umgebung: ohne R2-Zugangsdaten meldet er NOT_CONFIGURED, und das
# committet zu fuehren saehe aus wie ein Befund ueber den Speicher.
quant/data/market/history/endpoint-check.json
