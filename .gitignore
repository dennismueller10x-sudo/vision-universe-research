scripts/hedgefonds/__pycache__/
scripts/dashboard/__pycache__/

# Phase 2 — Zugangsdaten fuer Marktdatenanbieter.
# Der Schluessel gehoert in die Umgebung oder in ein GitHub-Secret,
# niemals in das Repository. Siehe docs/VU_MARKET_DATA_ARCHITECTURE.md.
.env
.env.*
!.env.example
*.key
secrets.json
providers/**/credentials.json

# Phase 4 — SEC Financial Data Core.
# SEC-Rohdaten und der Abruf-Cache sind gross und jederzeit reproduzierbar; sie
# duerfen das oeffentliche Repository nie erreichen. Die normalisierten
# Factbooks sind ebenfalls reproduzierbar und bleiben lokal. Committet werden
# nur die kompakten, pruefbaren Artefakte unter quant/data/sec/.
.sec-cache/
.quant-state/
quant/data/sec/raw/
quant/data/sec/facts/
scripts/quant/**/__pycache__/

# Phase 4A — Arbeitsablage fuer Kursdaten.
# Provider-Historien gehoeren nicht in ein oeffentliches Repository:
# zu gross, und Rohdaten-, Display- sowie Derived-Data-Rechte sind
# ungeklärt. Auch Ausschnitte bleiben bis zur Lizenzfreigabe intern.
.market-cache/

# Die Vorschau liest ihre Zugangsdaten aus der Umgebung, nie aus einer
# Datei. Falls jemand trotzdem eine anlegt, soll sie nicht mitkommen.
preview/.env
preview/.env.*
