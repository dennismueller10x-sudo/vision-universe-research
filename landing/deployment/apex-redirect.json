{
  "description": "Vision Universe: Apex dauerhaft auf www",
  "expression": "(http.host eq \"visionuniverse.de\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": {"expression": "concat(\"https://www.visionuniverse.de\", http.request.uri.path)"},
      "preserve_query_string": true
    }
  },
  "enabled": true
}
