{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "consensus-case-1.0.0",
 "title": "PRACTITIONER CONSENSUS REFERENCE — Konsensfall (Mission VII, Protokoll-Nachtrag 7)",
 "type": "object",
 "required": ["consensusCaseId", "anchorCaseId", "anchorSplit", "asset", "instrument", "timeframe", "referenceDateWindow", "practitionerReferences", "independentSourceFamilyCount", "consensusClass", "strength", "pairs", "impulse", "agreement", "note"],
 "properties": {
  "consensusCaseId": { "type": "string", "pattern": "^cc_[a-z0-9_-]+$" },
  "anchorCaseId": { "type": "string" },
  "anchorSplit": { "enum": ["DEVELOPMENT", "VALIDATION"] },
  "asset": { "type": ["string", "null"] },
  "instrument": { "type": "string" },
  "timeframe": { "enum": ["1D", "1W", "1M"] },
  "referenceDateWindow": { "type": "object", "required": ["anchorPublication", "windowTradingDays", "lags"] },
  "practitionerReferences": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["referenceId", "role", "sourceId", "sourceFamily", "sourceUrl", "publication", "timeframe", "confidence", "reading"],
    "properties": { "role": { "enum": ["ANCHOR", "LINKED"] }, "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] } } } },
  "linkedNotIncluded": { "type": "array" },
  "rejectedLinks": { "type": "array" },
  "independentSourceFamilyCount": { "type": "integer", "minimum": 1 },
  "consensusClass": { "enum": ["A_STRONG", "B_PARTIAL", "C_DISAGREEMENT", "D_SINGLE", "E_TIMEFRAME_ONLY", "UNDETERMINED"] },
  "strength": { "type": "object", "required": ["sourceFamilies"] },
  "pairs": { "type": "array" },
  "impulse": { "type": "object", "required": ["motiveFamilies", "consensusImpulse", "anchorMotive"] },
  "agreement": { "type": "object" },
  "note": { "const": "PRACTITIONER CONSENSUS REFERENCE, NOT GROUND TRUTH" }
 }
}
