        "statement": "Wave 3 ist nie die kuerzeste der Wellen 1, 3, 5 (pruefbar, sobald W5 vorliegt)."
      },
      {
        "ruleId": "W4_NO_W1_OVERLAP",
        "type": "HARD",
        "statement": "Im Standardimpuls betritt Wave 4 nicht das Preisgebiet von Wave 1 (bullish: low(W4) > end(W1))."
      },
      {
        "ruleId": "W4_NOT_BEYOND_W3_ORIGIN",
        "type": "HARD",
        "statement": "Wave 4 retraced Wave 3 nicht vollstaendig."
      }
    ],
    "ZIGZAG": [
      {
        "ruleId": "B_NOT_BEYOND_A_ORIGIN",
