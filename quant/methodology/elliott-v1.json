        "statement": "Wave B retraced nie mehr als 100 % von Wave A."
      },
      {
        "ruleId": "C_BEYOND_B_END",
        "type": "HARD",
        "statement": "Wave C bewegt sich ueber das Ende von B hinaus in Richtung A."
      }
    ]
