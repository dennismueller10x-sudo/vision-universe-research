        "ruleId": "W2_NOT_BEYOND_W1_ORIGIN",
        "type": "HARD",
        "statement": "Wave 2 retraced nie mehr als 100 % von Wave 1 (bullish: low(W2) > origin(W1))."
      },
      {
        "ruleId": "W3_BEYOND_W1_END",
        "type": "HARD",
        "statement": "Wave 3 ueberschreitet das Ende von Wave 1."
