+    /* SEC-Delisting-Beleg (Form 25/25-NSE/15, 8-K 2.01/3.01) mit quellenbelegtem letzten Handelstag.
+       Der Anbieter schreibt nach einem Delisting den letzten Kurs fort; sein endDate bleibt dadurch aktuell.
+       Ein Beleg darf nur ACTIVE -> INACTIVE kippen, nie umgekehrt, und nur fuer denselben Ticker mit
+       lastTradeDate <= today. */
+    var delisting = opts.secDelistings && opts.secDelistings[upper(row.ticker)];
+    if (delisting && active !== false && delisting.lastTradeDate && delisting.lastTradeDate <= today
+        && (!row.startDate || row.startDate <= delisting.lastTradeDate)) {
