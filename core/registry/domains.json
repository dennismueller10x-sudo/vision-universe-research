      "workflow": null,
      "schedule": "manuell",
      "freshness": { "kind": "hours", "warnAfter": 336, "staleAfter": 840 },
      "consumers": ["market-data-refresh (Abrufumfang)", "build-market-factors", "build-discover-data", "build-capability-matrix", "screener", "supertrader (indirekt ueber Discover)"],
      "knownGaps": ["Kein geplanter Erzeuger: Neuemissionen und Delistings kommen nur mit einem manuellen Lauf ins Universum.", "Identitaet ist tickerbasiert (ADR-001)."]
    },
    {
      "id": "companyMaster",
