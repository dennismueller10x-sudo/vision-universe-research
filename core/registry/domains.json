{
  "schemaVersion": "core-domain-registry-1.0.0",
  "note": "Source-of-Truth-Register der Vision-Universe-Plattform. Je Datenart genau ein kanonisches Artefakt, sein Erzeuger, sein Zeitplan, sein Frischevertrag und seine Verbraucher. Gelesen von core/health.js (Systemzustand), core/diagnose.js (Selbstdiagnose), scripts/core/*.mjs und /status/. Pfade sind Auslieferungspfade (Repository-Wurzel = Website-Wurzel). Eine neue Datenart wird HIER eingetragen, bevor ein Produkt sie liest - siehe docs/architecture/ADR-002-market-data-source-of-truth.md.",
  "repositoryOnly": "Artefakt wird bewusst nicht ausgeliefert (scripts/vu2/build-release.mjs#permitted: quant/data/sec, quant/data/fundamentals). Gegen die Seite gemessen heisst das NOT_DELIVERED, nicht FAILED.",
  "freshnessKinds": {
    "sessions": "Stand (asOf, ein Handelstag) gegen die letzte abgeschlossene US-Sitzung (quant/config/market-calendar.json). warnAfter/staleAfter in Handelstagen Rueckstand.",
    "hours": "Alter des Zeitstempels in Stunden. warnAfter/staleAfter in Stunden.",
    "intraday": "Intraday-Verzeichnis: bei offener Boerse Alter des letzten Takts in Minuten, nach Schluss vollstaendiger Tagesverlauf der letzten Sitzung.",
    "none": "Kein Frischevertrag (Referenzdaten oder abgeschaltet)."
  },
  "domains": [
    {
      "id": "deEuListings",
      "label": "DE/EU Index Listings (private Entwicklung)",
      "layer": "CORE",
      "group": "Securities",
      "critical": false,
      "artifact": "/core/data/de-eu/listings.json",
      "timestamp": [],
      "records": "listings",
      "role": "ISIN/MIC-getrennter Pflichtbestand DAX/MDAX/SDAX/TecDAX/EURO STOXX 50; lokale Close-Reihen unter core/data/de-eu/series/<listingId>.json. Öffentlicher Stand bleibt DISABLED. Produkte lesen ausschließlich core/client.js Listing-Verträge.",
      "producer": "scripts/marketstack/materialize-de-eu.mjs",
      "workflow": null,
      "schedule": "nur expliziter privater Entwicklungslauf; kein aktivierter Zeitplan",
      "freshness": { "kind": "none" },
      "disabledWhen": { "path": "state", "equals": "DISABLED" },
      "consumers": ["Discover lokale Suche, Listingseite und Watchlist (gestapelte Produkt-PR)"],
      "knownGaps": ["Account-Restkontingent nicht nachgewiesen; kostenpflichtiger Massenimport gesperrt.", "Öffentliche Rohkurs- und Displayrechte sind nicht allgemein bestätigt; reale DE/EU-Daten werden ausschließlich außerhalb des Repositorys materialisiert."]
    },
    {
      "id": "securityMaster",
      "label": "Security Master",
      "layer": "CORE",
      "group": "Securities",
      "critical": true,
      "artifact": "/quant/data/market/security-master/eligibility.json",
      "timestamp": ["generatedAt"],
      "records": "decisions",
