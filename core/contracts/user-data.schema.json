{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.visionuniverse.de/core/contracts/user-data.schema.json",
  "title": "Vision Universe User Data (v1)",
  "description": "Vorbereitetes Datenmodell der Nutzerdaten, strikt getrennt von Marktdaten (ADR-004, docs/architecture/APP_READINESS.md). Heute ohne Server-Verbraucher: die bestehenden Browser-Speicher (vu-discover-watchlist-v1, vu.quant.watchlist.v1, vu-currency-preference-v1, vu-discover-theme-v1) lassen sich verlustfrei in dieses Modell ueberfuehren. Wertpapiere werden ueber instrumentId referenziert (stabil), der Ticker ist nur Anzeige.",
  "type": "object",
  "required": ["schemaVersion", "userId"],
  "properties": {
    "schemaVersion": { "const": "vu-user-data-1.0.0" },
    "userId": { "type": "string", "description": "Opaque Kontokennung (kein E-Mail-Wert)." },
    "profile": {
      "type": "object",
      "properties": {
        "displayName": { "type": ["string", "null"] },
        "locale": { "type": "string", "default": "de-DE" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "displayCurrency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "EUR", "description": "heute: vu-currency-preference-v1" },
        "appearance": { "enum": ["light", "dark", "system"], "default": "system", "description": "heute: vu-discover-theme-v1" },
        "experienceLevel": { "enum": ["beginner", "advanced"], "default": "beginner" }
      }
    },
    "watchlists": {
      "type": "array",
      "description": "Eine Liste fuer alle Produkte. Heute getrennt: Discover (vu-discover-watchlist-v1) und Quant (vu.quant.watchlist.v1).",
      "items": {
        "type": "object",
        "required": ["id", "name", "items"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["instrumentId", "addedAt"],
              "properties": {
                "instrumentId": { "type": "string", "pattern": "^vu_[a-f0-9]+$" },
                "tickerAtAdd": { "type": "string", "description": "nur Anzeige/Migration; kein Join-Schluessel" },
                "addedAt": { "type": "string", "format": "date-time" },
                "note": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "portfolios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "baseCurrency", "positions"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "baseCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["instrumentId", "quantity"],
              "properties": {
                "instrumentId": { "type": "string", "pattern": "^vu_[a-f0-9]+$" },
                "quantity": { "type": "number" },
                "costBasis": { "type": ["number", "null"] },
                "openedAt": { "type": ["string", "null"], "format": "date" }
              }
            }
          }
        }
      }
    },
    "notificationSettings": {
      "type": "object",
      "description": "Opt-in je Ereignisart (core/contracts/events.schema.json). Standard: alles aus.",
      "additionalProperties": { "type": "boolean" },
      "propertyNames": { "enum": ["WATCHLIST_NEWS", "EARNINGS", "PRICE_EVENT", "SUPERTRADER_SIGNAL", "QUANT_CHANGE", "MARKET_REGIME_CHANGE"] }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["deviceId", "platform", "registeredAt"],
        "properties": {
          "deviceId": { "type": "string" },
          "platform": { "enum": ["ios", "android", "web"] },
          "pushToken": { "type": ["string", "null"], "description": "nie in Logs, nie im Client-Bundle" },
          "registeredAt": { "type": "string", "format": "date-time" },
          "lastSeenAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "entitlements": {
      "type": "object",
      "properties": {
        "plan": { "enum": ["free", "plus", "pro"], "default": "free" },
        "validUntil": { "type": ["string", "null"], "format": "date-time" },
        "source": { "enum": ["none", "app_store", "play_store", "web"], "default": "none" }
      }
    },
    "featureFlags": { "type": "object", "additionalProperties": { "type": "boolean" } }
  }
}
